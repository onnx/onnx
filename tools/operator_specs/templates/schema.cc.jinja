{#- Functions returning the OpSchema of each version of one operator, and their registration. -#}
{% if op.is_ml %}
#ifdef ONNX_ML
{% endif %}
#include "onnx/defs/generated/schemas.h"
{% for header in op.includes %}
#include "{{ header }}"
{% endfor %}

namespace ONNX_NAMESPACE::generated::{{ op.namespace }} {
{% for v in op.versions %}

// Generated from {{ v.source }}.
OpSchema {{ v.function_name }}() {
  OpSchema schema;
{% for call in v.cpp_calls() %}
  schema.{{ call }};
{% endfor %}
  return schema;
}
{% endfor %}

} // namespace ONNX_NAMESPACE::generated::{{ op.namespace }}

namespace ONNX_NAMESPACE {
{% for v in op.versions %}

// The location of the schema is its spec file.
#line 1 "{{ v.source }}"
{{ op.macro }}({{ op.name }}, {{ v.since_version }}, generated::{{ op.namespace }}::{{ v.function_name }}());
{% endfor %}

} // namespace ONNX_NAMESPACE
{% if op.is_ml %}
#endif // ONNX_ML
{% endif %}
